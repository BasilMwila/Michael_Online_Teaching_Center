# Copy to .env.local and fill in values from Firebase console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (free tier — no card required)
# 1. Sign up at https://cloudinary.com (free)
# 2. Cloud Name is on the dashboard
# 3. Settings → Upload → Add upload preset → Signing Mode: Unsigned → copy the preset name
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Public-facing bank details shown to students on the payment page
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=Empire Skills Training Center
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_SWIFT=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
