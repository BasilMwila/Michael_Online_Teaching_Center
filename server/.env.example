# Copy to .env and adjust. Loaded automatically at startup (Node's loadEnvFile).
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/empireskills.db
# Comma-separated origins allowed by CORS (the Vite dev server + production site)
CORS_ORIGINS=http://localhost:5173

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@empireskills.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin

# ---------- AI lecture import ----------
# OpenAI key used to segment uploaded PDFs/PowerPoints into lessons.
OPENAI_API_KEY=
# gpt-4o handles long documents well; gpt-4o-mini is far cheaper and usually fine.
OPENAI_MODEL=gpt-4o
# Largest document accepted for AI import, in megabytes.
MAX_UPLOAD_MB=25

# The browser app signs in with Firebase, so the AI endpoints verify Firebase ID
# tokens. Required — without it the AI import stays disabled.
FIREBASE_PROJECT_ID=empireskills-8cd40
# Any account whose Firestore profile has role="admin" may run the AI import.
# ADMIN_EMAILS is an optional break-glass list that is allowed regardless of
# role (useful if Firestore is unreachable). Comma-separated.
ADMIN_EMAILS=
