{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(firebase --version)",
      "Bash(firebase deploy *)",
      "PowerShell(Get-Process node -ErrorAction SilentlyContinue)",
      "PowerShell(Stop-Process -Force)",
      "PowerShell(\"killed\")",
      "Bash(node -e \"import\\('./tailwind.config.js'\\).then\\(c => console.log\\('walnut.700:', c.default.theme.extend.colors.walnut?.['700']\\)\\)\")",
      "Bash(tasklist)",
      "Bash(netstat -ano)",
      "Bash(npx tailwindcss *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(git commit --allow-empty -m ' *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/basil/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/basil/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}